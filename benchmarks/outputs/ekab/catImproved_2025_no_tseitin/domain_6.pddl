(define (domain BTcat)
(:constants
  a b c d e f g h i j k l - object)
(:predicates
  (cat ?x - object)
  (orangecat ?x - object)
  (blackcat ?x - object)
  (bomb ?x - object)
  (jagerbomb ?x - object)
  (dynamitebomb ?x - object)
  (smokebomb ?x - object)
  (contains ?x ?y - object)
  (package ?x - object)
  (disarmed ?x - object)
  (obj ?x - object)
  (DATALOG_QUERY1 ?x0 ?x1 - object)
  (DATALOG_QUERY0 ?x0 ?x1 - object)
  (DATALOG_PACKAGE ?x0 - object)
  (DATALOG_BOMB ?x0 - object)
  (DATALOG_INCONSISTENT )
  (DATALOG_CAT ?x0 - object))
(:derived (DATALOG_QUERY1 ?x0 ?x1 - object)
          (and (DATALOG_CAT ?x1) (contains ?x0 ?x1)))
(:derived (DATALOG_QUERY0 ?x0 ?x1 - object)
          (and (DATALOG_BOMB ?x1) (contains ?x0 ?x1)))
(:derived (DATALOG_PACKAGE ?x0 - object)
          (package ?x0))
(:derived (DATALOG_PACKAGE ?x0 - object)
          (exists (?y0 - object) (contains ?x0 ?y0)))
(:derived (DATALOG_BOMB ?x0 - object)
          (bomb ?x0))
(:derived (DATALOG_BOMB ?x0 - object)
          (smokebomb ?x0))
(:derived (DATALOG_INCONSISTENT )
          (exists (?y0 - object) (and (DATALOG_BOMB ?y0) (DATALOG_CAT ?y0))))
(:derived (DATALOG_INCONSISTENT )
          (exists (?y0 ?y1 ?y2 - object) (and (contains ?y0 ?y1) (contains ?y0 ?y2) (not (= ?y1 ?y2)))))
(:derived (DATALOG_CAT ?x0 - object)
          (cat ?x0))
(:derived (DATALOG_CAT ?x0 - object)
          (blackcat ?x0))
(:derived (DATALOG_CAT ?x0 - object)
          (orangecat ?x0))
(:action dunk
  :parameters (?x ?y - object)
  :precondition (and (DATALOG_PACKAGE ?x) (not (DATALOG_INCONSISTENT)))
  :effect (when (DATALOG_QUERY0 ?x ?y) (and (disarmed ?x))))
(:action let_the_cats_out
  :parameters (?x ?y - object)
  :precondition (and (DATALOG_PACKAGE ?x) (not (DATALOG_INCONSISTENT)))
  :effect (when (DATALOG_QUERY1 ?x ?y) (and (not (package ?x)))))
)
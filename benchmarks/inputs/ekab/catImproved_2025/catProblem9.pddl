(define (problem BTcat_problem)
	(:domain BTcat)
	(:objects a b c d e f g h i j k l m n o p q r )
	(:init
		(blackcat a)
		(blackcat d)
		(orangecat g)
		(orangecat h)
		(dynamitebomb i)
		(blackcat n)
		(dynamitebomb o)
		(contains f o)
		(contains m i)
		(contains q n)
		(contains k h)
		(contains j a)
		(contains r d)
		(contains l g)
	)
	(:goal (not (exists (?x) 
 		 (and 
 			 (mko (package ?x)) 
 			 (not (mko (disarmed ?x))) 
 		 ) 
 	 )) 
 	)

)
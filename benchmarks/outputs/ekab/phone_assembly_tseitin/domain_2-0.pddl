(define (domain phone_assembly)
(:requirements :universal-preconditions :conditional-effects)
(:predicates
  (screeninstalledin ?s ?p - object)
  (batteryinstalledin ?b ?p - object)
  (processorinstalledin ?r ?p - object)
  (phone ?x - object)
  (screen ?x - object)
  (battery ?x - object)
  (processor ?x - object)
  (component ?x - object)
  (inspected ?x - object)
  (tested ?x - object)
  (hasscreen ?p - object)
  (hasbattery ?p - object)
  (hasprocessor ?p - object)
  (fullyequipped ?p - object)
  (readytouse ?x - object)
  (hasbrokenscreen ?p ?s - object)
  (hasbrokenbattery ?p ?b - object)
  (hasbrokenprocessor ?p ?r - object)
  (hasdefect ?p - object)
  (brokenphone ?p - object)
  (warrantyclaim ?p - object)
  (underwarranty ?p - object)
  (repairauthorized ?p - object)
  (DATALOG_INCONSISTENT)
  (DATALOG_HASDEFECT ?x0 - object)
  (DATALOG_HASPROCESSOR ?x0 - object)
  (DATALOG_WARRANTYCLAIM ?x0 - object)
  (DATALOG_COMPONENT ?x0 - object)
  (DATALOG_HASBATTERY ?x0 - object)
  (DATALOG_HASSCREEN ?x0 - object)
  (DATALOG_BROKENPHONE ?x0 - object)
  (DATALOG_FULLYEQUIPPED ?x0 - object)
  (DATALOG_READYTOUSE ?x0 - object)
  (AUX0 ?y2 - object ?y0 - object ?y1 - object)
  (AUX1 ?y2 - object ?y0 - object ?y1 - object)
  (AUX2 ?y2 - object ?y0 - object ?y1 - object)
  (AUX3 ?y2 - object ?y0 - object ?y1 - object)
  (AUX4 ?y2 - object ?y0 - object ?y1 - object)
  (AUX5 ?y2 - object ?y0 - object ?y1 - object)
  (AUX6 ?y2 - object ?y0 - object ?y1 - object)
  (AUX7 ?y2 - object ?y0 - object ?y1 - object)
  (AUX8 ?y2 - object ?y0 - object ?y1 - object)
  (AUX9 ?y2 - object ?y0 - object ?y1 - object)
  (AUX10 ?y2 - object ?y0 - object ?y1 - object)
  (AUX11 ?y2 - object ?y0 - object ?y1 - object)
  (AUX12 ?p - object)
  (AUX13 ?p - object)
  (AUX14 ?p - object)
  (AUX15 ?p - object))
(:derived (DATALOG_INCONSISTENT)
          (exists (?y0 ?y1 ?y2 - object) (AUX0 ?y2 ?y0 ?y1)))
(:derived (DATALOG_HASDEFECT ?x0 - object)
          (hasdefect ?x0))
(:derived (DATALOG_HASDEFECT ?x0 - object)
          (exists (?y0 - object) (hasbrokenbattery ?x0 ?y0)))
(:derived (DATALOG_HASPROCESSOR ?x0 - object)
          (hasprocessor ?x0))
(:derived (DATALOG_HASPROCESSOR ?x0 - object)
          (exists (?y0 - object) (processorinstalledin ?y0 ?x0)))
(:derived (DATALOG_INCONSISTENT)
          (exists (?y0 ?y1 ?y2 - object) (AUX1 ?y2 ?y0 ?y1)))
(:derived (DATALOG_WARRANTYCLAIM ?x0 - object)
          (warrantyclaim ?x0))
(:derived (DATALOG_WARRANTYCLAIM ?x0 - object)
          (and (DATALOG_HASDEFECT ?x0) (underwarranty ?x0)))
(:derived (DATALOG_INCONSISTENT)
          (exists (?y0 ?y1 ?y2 - object) (AUX2 ?y2 ?y0 ?y1)))
(:derived (DATALOG_COMPONENT ?x0 - object)
          (component ?x0))
(:derived (DATALOG_COMPONENT ?x0 - object)
          (battery ?x0))
(:derived (DATALOG_HASBATTERY ?x0 - object)
          (hasbattery ?x0))
(:derived (DATALOG_HASBATTERY ?x0 - object)
          (exists (?y0 - object) (batteryinstalledin ?y0 ?x0)))
(:derived (DATALOG_INCONSISTENT)
          (exists (?y0 ?y1 ?y2 - object) (AUX3 ?y2 ?y0 ?y1)))
(:derived (DATALOG_HASSCREEN ?x0 - object)
          (hasscreen ?x0))
(:derived (DATALOG_HASSCREEN ?x0 - object)
          (exists (?y0 - object) (screeninstalledin ?y0 ?x0)))
(:derived (DATALOG_BROKENPHONE ?x0 - object)
          (brokenphone ?x0))
(:derived (DATALOG_BROKENPHONE ?x0 - object)
          (and (DATALOG_FULLYEQUIPPED ?x0) (DATALOG_HASDEFECT ?x0)))
(:derived (DATALOG_COMPONENT ?x0 - object)
          (processor ?x0))
(:derived (DATALOG_HASDEFECT ?x0 - object)
          (exists (?y0 - object) (hasbrokenprocessor ?x0 ?y0)))
(:derived (DATALOG_INCONSISTENT)
          (exists (?y0 ?y1 ?y2 - object) (AUX4 ?y2 ?y0 ?y1)))
(:derived (DATALOG_INCONSISTENT)
          (exists (?y0 ?y1 ?y2 - object) (AUX5 ?y2 ?y0 ?y1)))
(:derived (DATALOG_INCONSISTENT)
          (exists (?y0 ?y1 ?y2 - object) (AUX6 ?y2 ?y0 ?y1)))
(:derived (DATALOG_INCONSISTENT)
          (exists (?y0 ?y1 ?y2 - object) (AUX7 ?y2 ?y0 ?y1)))
(:derived (DATALOG_HASDEFECT ?x0 - object)
          (exists (?y0 - object) (hasbrokenscreen ?x0 ?y0)))
(:derived (DATALOG_INCONSISTENT)
          (exists (?y0 ?y1 ?y2 - object) (AUX8 ?y2 ?y0 ?y1)))
(:derived (DATALOG_INCONSISTENT)
          (exists (?y0 ?y1 ?y2 - object) (AUX9 ?y2 ?y0 ?y1)))
(:derived (DATALOG_INCONSISTENT)
          (exists (?y0 ?y1 ?y2 - object) (AUX10 ?y2 ?y0 ?y1)))
(:derived (DATALOG_FULLYEQUIPPED ?x0 - object)
          (fullyequipped ?x0))
(:derived (DATALOG_FULLYEQUIPPED ?x0 - object)
          (and (DATALOG_HASBATTERY ?x0) (DATALOG_HASPROCESSOR ?x0) (DATALOG_HASSCREEN ?x0)))
(:derived (DATALOG_COMPONENT ?x0 - object)
          (screen ?x0))
(:derived (DATALOG_READYTOUSE ?x0 - object)
          (readytouse ?x0))
(:derived (DATALOG_READYTOUSE ?x0 - object)
          (and (inspected ?x0) (tested ?x0)))
(:derived (DATALOG_INCONSISTENT)
          (exists (?y0 ?y1 ?y2 - object) (AUX11 ?y2 ?y0 ?y1)))
(:derived (AUX0 ?y2 - object ?y0 - object ?y1 - object)
          (and (processorinstalledin ?y0 ?y1) (processorinstalledin ?y0 ?y2) (not (= ?y1 ?y2))))
(:derived (AUX1 ?y2 - object ?y0 - object ?y1 - object)
          (and (processorinstalledin ?y0 ?y2) (processorinstalledin ?y1 ?y2) (not (= ?y0 ?y1))))
(:derived (AUX2 ?y2 - object ?y0 - object ?y1 - object)
          (and (batteryinstalledin ?y0 ?y2) (batteryinstalledin ?y1 ?y2) (not (= ?y0 ?y1))))
(:derived (AUX3 ?y2 - object ?y0 - object ?y1 - object)
          (and (hasbrokenbattery ?y0 ?y2) (hasbrokenbattery ?y1 ?y2) (not (= ?y0 ?y1))))
(:derived (AUX4 ?y2 - object ?y0 - object ?y1 - object)
          (and (hasbrokenprocessor ?y0 ?y1) (hasbrokenprocessor ?y0 ?y2) (not (= ?y1 ?y2))))
(:derived (AUX5 ?y2 - object ?y0 - object ?y1 - object)
          (and (hasbrokenprocessor ?y0 ?y2) (hasbrokenprocessor ?y1 ?y2) (not (= ?y0 ?y1))))
(:derived (AUX6 ?y2 - object ?y0 - object ?y1 - object)
          (and (screeninstalledin ?y0 ?y2) (screeninstalledin ?y1 ?y2) (not (= ?y0 ?y1))))
(:derived (AUX7 ?y2 - object ?y0 - object ?y1 - object)
          (and (screeninstalledin ?y0 ?y1) (screeninstalledin ?y0 ?y2) (not (= ?y1 ?y2))))
(:derived (AUX8 ?y2 - object ?y0 - object ?y1 - object)
          (and (batteryinstalledin ?y0 ?y1) (batteryinstalledin ?y0 ?y2) (not (= ?y1 ?y2))))
(:derived (AUX9 ?y2 - object ?y0 - object ?y1 - object)
          (and (hasbrokenscreen ?y0 ?y2) (hasbrokenscreen ?y1 ?y2) (not (= ?y0 ?y1))))
(:derived (AUX10 ?y2 - object ?y0 - object ?y1 - object)
          (and (hasbrokenbattery ?y0 ?y1) (hasbrokenbattery ?y0 ?y2) (not (= ?y1 ?y2))))
(:derived (AUX11 ?y2 - object ?y0 - object ?y1 - object)
          (and (hasbrokenscreen ?y0 ?y1) (hasbrokenscreen ?y0 ?y2) (not (= ?y1 ?y2))))
(:derived (AUX12 ?p - object)
          (and (DATALOG_WARRANTYCLAIM ?p) (not (DATALOG_HASDEFECT ?p))))
(:derived (AUX13 ?p - object)
          (or (AUX12 ?p) (not (underwarranty ?p))))
(:derived (AUX14 ?p - object)
          (and (DATALOG_FULLYEQUIPPED ?p) (AUX13 ?p)))
(:derived (AUX15 ?p - object)
          (or (AUX14 ?p) (not (phone ?p))))
(:action inspect
  :parameters (?c - object)
  :precondition (and (DATALOG_COMPONENT ?c) (not (DATALOG_INCONSISTENT)))
  :effect (inspected ?c))
(:action test
  :parameters (?c - object)
  :precondition (and (DATALOG_COMPONENT ?c) (inspected ?c) (not (DATALOG_INCONSISTENT)))
  :effect (tested ?c))
(:action install-screen
  :parameters (?s ?p - object)
  :precondition (and (DATALOG_COMPONENT ?s) (DATALOG_READYTOUSE ?s) (phone ?p) (screen ?s) (forall (?b - object) (not (hasbrokenscreen ?p ?b))) (not (DATALOG_HASSCREEN ?p)) (not (DATALOG_INCONSISTENT)))
  :effect (screeninstalledin ?s ?p))
(:action install-battery
  :parameters (?b ?p - object)
  :precondition (and (DATALOG_COMPONENT ?b) (DATALOG_READYTOUSE ?b) (battery ?b) (phone ?p) (forall (?b2 - object) (not (hasbrokenbattery ?p ?b2))) (not (DATALOG_HASBATTERY ?p)) (not (DATALOG_INCONSISTENT)))
  :effect (batteryinstalledin ?b ?p))
(:action install-processor
  :parameters (?r ?p - object)
  :precondition (and (DATALOG_COMPONENT ?r) (DATALOG_READYTOUSE ?r) (phone ?p) (processor ?r) (forall (?b - object) (not (hasbrokenprocessor ?p ?b))) (not (DATALOG_HASPROCESSOR ?p)) (not (DATALOG_INCONSISTENT)))
  :effect (processorinstalledin ?r ?p))
(:action authorize-repair
  :parameters (?p - object)
  :precondition (and (DATALOG_BROKENPHONE ?p) (phone ?p) (underwarranty ?p) (not (DATALOG_INCONSISTENT)))
  :effect (repairauthorized ?p))
(:action repair
  :parameters (?p - object)
  :precondition (and (DATALOG_BROKENPHONE ?p) (phone ?p) (repairauthorized ?p) (not (DATALOG_INCONSISTENT)))
  :effect (and (not (brokenphone ?p)) (forall (?s - object) (when (hasbrokenscreen ?p ?s) (and (not (screeninstalledin ?s ?p)) (not (fullyequipped ?p))))) (forall (?b - object) (when (hasbrokenbattery ?p ?b) (and (not (batteryinstalledin ?b ?p)) (not (fullyequipped ?p))))) (forall (?r - object) (when (hasbrokenprocessor ?p ?r) (and (not (processorinstalledin ?r ?p)) (not (fullyequipped ?p)))))))
)
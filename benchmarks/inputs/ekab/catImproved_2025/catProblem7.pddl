(define (problem BTcat_problem)
	(:domain BTcat)
	(:objects a b c d e f g h i j k l m n )
	(:init
		(smokebomb b)
		(blackcat d)
		(blackcat f)
		(smokebomb h)
		(blackcat l)
		(blackcat m)
		(contains k h)
		(contains i b)
		(contains c f)
		(contains e d)
		(contains j l)
		(contains g m)
	)
	(:goal (not (exists (?x) 
 		 (and 
 			 (mko (package ?x)) 
 			 (not (mko (disarmed ?x))) 
 		 ) 
 	 )) 
 	)

)
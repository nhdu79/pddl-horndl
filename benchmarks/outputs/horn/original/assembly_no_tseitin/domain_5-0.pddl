(define (domain assembly)
(:requirements :universal-preconditions)
(:constants
  phone_1 phone_2 phone_3 phone_4 phone_5 screen_1 screen_2 screen_3 screen_4 screen_5 battery_1 battery_2 battery_3 battery_4 battery_5 board_1 board_2 board_3 board_4 board_5 - object)
(:predicates
  (screeninstalledin ?s ?p - object)
  (batteryinstalledin ?b ?p - object)
  (boardinstalledin ?r ?p - object)
  (screen ?x - object)
  (battery ?x - object)
  (processor ?x - object)
  (inspected ?x - object)
  (tested ?x - object)
  (hasscreen ?p - object)
  (hasbattery ?p - object)
  (hasboard ?p - object)
  (hascorecomponents ?p - object)
  (fullyequipped ?p - object)
  (readytouse ?x - object)
  (validated ?p - object)
  (productrecord ?p - object)
  (DATALOG_INCONSISTENT )
  (DATALOG_HASSCREEN ?x0 - object)
  (DATALOG_READYTOUSE ?x0 - object)
  (DATALOG_FULLYEQUIPPED ?x0 - object)
  (DATALOG_HASBOARD ?x0 - object)
  (DATALOG_HASCORECOMPONENTS ?x0 - object)
  (DATALOG_HASBATTERY ?x0 - object))
(:derived (DATALOG_INCONSISTENT )
          (exists (?y0 ?y1 ?y2 - object) (and (boardinstalledin ?y0 ?y1) (boardinstalledin ?y0 ?y2) (not (= ?y1 ?y2)))))
(:derived (DATALOG_INCONSISTENT )
          (exists (?y0 ?y1 ?y2 - object) (and (screeninstalledin ?y0 ?y1) (screeninstalledin ?y0 ?y2) (not (= ?y1 ?y2)))))
(:derived (DATALOG_HASSCREEN ?x0 - object)
          (hasscreen ?x0))
(:derived (DATALOG_HASSCREEN ?x0 - object)
          (exists (?y0 - object) (screeninstalledin ?y0 ?x0)))
(:derived (DATALOG_READYTOUSE ?x0 - object)
          (readytouse ?x0))
(:derived (DATALOG_READYTOUSE ?x0 - object)
          (and (inspected ?x0) (tested ?x0)))
(:derived (DATALOG_FULLYEQUIPPED ?x0 - object)
          (fullyequipped ?x0))
(:derived (DATALOG_FULLYEQUIPPED ?x0 - object)
          (and (DATALOG_HASBOARD ?x0) (DATALOG_HASCORECOMPONENTS ?x0)))
(:derived (DATALOG_HASBOARD ?x0 - object)
          (hasboard ?x0))
(:derived (DATALOG_HASBOARD ?x0 - object)
          (exists (?y0 - object) (boardinstalledin ?y0 ?x0)))
(:derived (DATALOG_HASCORECOMPONENTS ?x0 - object)
          (hascorecomponents ?x0))
(:derived (DATALOG_HASCORECOMPONENTS ?x0 - object)
          (and (DATALOG_HASBATTERY ?x0) (DATALOG_HASSCREEN ?x0)))
(:derived (DATALOG_HASBATTERY ?x0 - object)
          (hasbattery ?x0))
(:derived (DATALOG_HASBATTERY ?x0 - object)
          (exists (?y0 - object) (batteryinstalledin ?y0 ?x0)))
(:derived (DATALOG_INCONSISTENT )
          (exists (?y0 ?y1 ?y2 - object) (and (batteryinstalledin ?y0 ?y1) (batteryinstalledin ?y0 ?y2) (not (= ?y1 ?y2)))))
(:action certify
  :parameters (?c - object)
  :precondition (and (not (DATALOG_INCONSISTENT)) (or (battery ?c) (processor ?c) (screen ?c)))
  :effect (and (inspected ?c) (tested ?c)))
(:action install-screen
  :parameters (?s ?p - object)
  :precondition (and (DATALOG_READYTOUSE ?s) (screen ?s) (forall (?p2 - object) (not (screeninstalledin ?s ?p2))) (not (DATALOG_HASSCREEN ?p)) (not (DATALOG_INCONSISTENT)))
  :effect (screeninstalledin ?s ?p))
(:action install-battery
  :parameters (?b ?p - object)
  :precondition (and (DATALOG_READYTOUSE ?b) (battery ?b) (not (DATALOG_HASBATTERY ?p)) (not (DATALOG_INCONSISTENT)))
  :effect (batteryinstalledin ?b ?p))
(:action install-board
  :parameters (?r ?p - object)
  :precondition (and (DATALOG_READYTOUSE ?r) (processor ?r) (not (DATALOG_HASBOARD ?p)) (not (DATALOG_INCONSISTENT)))
  :effect (boardinstalledin ?r ?p))
(:action validate-assembly
  :parameters (?p - object)
  :precondition (and (DATALOG_FULLYEQUIPPED ?p) (not (DATALOG_INCONSISTENT)))
  :effect (validated ?p))
(:action remove-and-rework-screen
  :parameters (?s ?p - object)
  :precondition (and (DATALOG_READYTOUSE ?s) (screeninstalledin ?s ?p) (not (DATALOG_INCONSISTENT)))
  :effect (and (not (fullyequipped ?p)) (inspected ?s) (not (readytouse ?s))))
)
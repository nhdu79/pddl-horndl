(define (domain BLOCKS)

(:predicates
	(ONBLOCK ?x ?y)
	(ONTABLE ?x ?y)
	(on ?x ?y)
	(BLOCK ?x)
	(TABLE ?x)
	(BLOCKED ?x)
  (HOLDING ?x)
)

(:action pick-up
  :parameters (?x ?y)
  :precondition (and (mko (on ?x ?y))
                     (not (mko (BLOCKED ?x)))
                     (not (mko (exists (?x) (HOLDING ?x))))
  )
  :effect (and (not (on ?x ?y))
    (not (ONBLOCK ?x ?y))
    (not (ONTABLE ?x ?y))
    (HOLDING ?x)
    (not (BLOCKED ?y))
  )
)

(:action put-down
  :parameters (?x ?y)
  :precondition (and (HOLDING ?x)
                     (not (mko (BLOCKED ?y)))
  )
  :effect (and (not (HOLDING ?x))
               (not (BLOCKED ?x))
               (when (mko (TABLE ?y))
                     (ONTABLE ?x ?y))
               (when (mko (BLOCK ?y))
                     (ONBLOCK ?x ?y))
  )
)

)

(define (problem BTcat_problem)
(:domain BTcat)
(:objects
  a b c d e f g h i j k l m n o p q r s t u v w x - object)
(:init
       (dynamitebomb c)
       (blackcat f)
       (blackcat j)
       (orangecat k)
       (orangecat n)
       (orangecat p)
       (dynamitebomb q)
       (orangecat r)
       (orangecat v)
       (dynamitebomb w)
       (contains l c)
       (contains o w)
       (contains t q)
       (contains g f)
       (contains a k)
       (contains e n)
       (contains m j)
       (contains u r)
       (contains h p)
       (contains x v))
(:goal (and (forall (?x - object) (or (disarmed ?x) (not (DATALOG_PACKAGE ?x)))) (not (DATALOG_INCONSISTENT))))
)
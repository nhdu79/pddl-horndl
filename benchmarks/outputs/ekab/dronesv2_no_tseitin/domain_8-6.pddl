(define (domain drone)
(:requirements :conditional-effects)
(:constants
  aa ab ac ad ae af ag ah ba bb bc bd be bf bg bh ca cb cc cd ce cf cg ch da db dc dd de df dg dh ea eb ec ed ee ef eg eh fa fb fc fd fe ff fg fh ga gb gc gd ge gf gg gh ha hb hc hd he hf hg hh env - object)
(:predicates
  (near ?x ?y - object)
  (veryclose ?x ?y - object)
  (environment ?x ?y - object)
  (drone ?x - object)
  (wetdrone ?x - object)
  (human ?x - object)
  (movingobject ?x - object)
  (objectx ?x - object)
  (tree ?x - object)
  (rain ?x - object)
  (lowvisibility ?x - object)
  (riskofphysicaldamage ?x - object)
  (environmentlow ?x ?y - object)
  (environmentrain ?x ?y - object)
  (nearobject ?x ?y - object)
  (nearmoving ?x ?y - object)
  (verycloseobject ?x ?y - object)
  (nonhornauxupdate)
  (DATALOG_INCONSISTENT )
  (DATALOG_NEAR ?x0 ?x1 - object)
  (DATALOG_RISKOFPHYSICALDAMAGE ?x0 - object)
  (DATALOG_QUERY0 ?x0 ?x1 - object)
  (DATALOG_VERYCLOSE ?x0 ?x1 - object)
  (DATALOG_NEARMOVINGSOMETHING ?x0 - object)
  (DATALOG_OBJECTX ?x0 - object)
  (DATALOG_VERYCLOSEOBJECTSOMETHING ?x0 - object)
  (DATALOG_ENVIRONMENTLOW ?x0 ?x1 - object)
  (DATALOG_MOVINGOBJECT ?x0 - object)
  (DATALOG_QUERY1 )
  (DATALOG_DRONE ?x0 - object)
  (DATALOG_ENVIRONMENTLOWSOMETHING ?x0 - object)
  (DATALOG_NEAROBJECTSOMETHING ?x0 - object))
(:derived (DATALOG_INCONSISTENT )
          (exists (?y0 - object) (and (DATALOG_DRONE ?y0) (human ?y0))))
(:derived (DATALOG_NEAR ?x0 ?x1 - object)
          (near ?x0 ?x1))
(:derived (DATALOG_NEAR ?x0 ?x1 - object)
          (nearobject ?x0 ?x1))
(:derived (DATALOG_NEAR ?x0 ?x1 - object)
          (DATALOG_NEAR ?x1 ?x0))
(:derived (DATALOG_RISKOFPHYSICALDAMAGE ?x0 - object)
          (riskofphysicaldamage ?x0))
(:derived (DATALOG_RISKOFPHYSICALDAMAGE ?x0 - object)
          (and (DATALOG_DRONE ?x0) (DATALOG_VERYCLOSEOBJECTSOMETHING ?x0)))
(:derived (DATALOG_QUERY0 ?x0 ?x1 - object)
          (and (DATALOG_DRONE ?x0) (DATALOG_VERYCLOSE ?x0 ?x1)))
(:derived (DATALOG_VERYCLOSE ?x0 ?x1 - object)
          (veryclose ?x0 ?x1))
(:derived (DATALOG_VERYCLOSE ?x0 ?x1 - object)
          (verycloseobject ?x0 ?x1))
(:derived (DATALOG_NEARMOVINGSOMETHING ?x0 - object)
          (exists (?y0 - object) (nearmoving ?x0 ?y0)))
(:derived (DATALOG_NEAR ?x0 ?x1 - object)
          (DATALOG_VERYCLOSE ?x0 ?x1))
(:derived (DATALOG_OBJECTX ?x0 - object)
          (objectx ?x0))
(:derived (DATALOG_OBJECTX ?x0 - object)
          (DATALOG_MOVINGOBJECT ?x0))
(:derived (DATALOG_VERYCLOSEOBJECTSOMETHING ?x0 - object)
          (exists (?y0 - object) (verycloseobject ?x0 ?y0)))
(:derived (DATALOG_RISKOFPHYSICALDAMAGE ?x0 - object)
          (and (DATALOG_DRONE ?x0) (DATALOG_NEARMOVINGSOMETHING ?x0)))
(:derived (DATALOG_ENVIRONMENTLOW ?x0 ?x1 - object)
          (environmentlow ?x0 ?x1))
(:derived (DATALOG_ENVIRONMENTLOW ?x0 ?x1 - object)
          (environmentrain ?x0 ?x1))
(:derived (DATALOG_VERYCLOSE ?x0 ?x1 - object)
          (DATALOG_VERYCLOSE ?x1 ?x0))
(:derived (DATALOG_OBJECTX ?x0 - object)
          (tree ?x0))
(:derived (DATALOG_MOVINGOBJECT ?x0 - object)
          (movingobject ?x0))
(:derived (DATALOG_MOVINGOBJECT ?x0 - object)
          (DATALOG_DRONE ?x0))
(:derived (DATALOG_QUERY1 )
          (exists (?y0 ?y1 - object) (and (DATALOG_NEAR ?y0 ?y1) (DATALOG_RISKOFPHYSICALDAMAGE ?y0) (DATALOG_RISKOFPHYSICALDAMAGE ?y1))))
(:derived (DATALOG_DRONE ?x0 - object)
          (drone ?x0))
(:derived (DATALOG_DRONE ?x0 - object)
          (wetdrone ?x0))
(:derived (DATALOG_RISKOFPHYSICALDAMAGE ?x0 - object)
          (and (DATALOG_DRONE ?x0) (DATALOG_ENVIRONMENTLOWSOMETHING ?x0) (DATALOG_NEAROBJECTSOMETHING ?x0)))
(:derived (DATALOG_MOVINGOBJECT ?x0 - object)
          (human ?x0))
(:derived (DATALOG_ENVIRONMENTLOWSOMETHING ?x0 - object)
          (exists (?y0 - object) (DATALOG_ENVIRONMENTLOW ?x0 ?y0)))
(:derived (DATALOG_NEAROBJECTSOMETHING ?x0 - object)
          (exists (?y0 - object) (nearobject ?x0 ?y0)))
(:derived (DATALOG_NEAR ?x0 ?x1 - object)
          (nearmoving ?x0 ?x1))
(:action _Supplement
  :parameters ()
  :precondition (and (not (DATALOG_INCONSISTENT)) (not (nonhornauxupdate)))
  :effect (and (forall (?x ?y - object) (when (and (environment ?x ?y) (rain ?y)) (environmentrain ?x ?y))) (forall (?x ?y - object) (when (and (environmentrain ?x ?y) (not (rain ?y))) (not (environmentrain ?x ?y)))) (forall (?x ?y - object) (when (and (environment ?x ?y) (lowvisibility ?y)) (environmentlow ?x ?y))) (forall (?x ?y - object) (when (and (environmentlow ?x ?y) (not (lowvisibility ?y))) (not (environmentlow ?x ?y)))) (forall (?x ?y - object) (when (and (DATALOG_NEAR ?x ?y) (DATALOG_OBJECTX ?y)) (nearobject ?x ?y))) (forall (?x ?y - object) (when (and (nearobject ?x ?y) (not (DATALOG_OBJECTX ?y))) (not (nearobject ?x ?y)))) (forall (?x ?y - object) (when (and (DATALOG_MOVINGOBJECT ?y) (DATALOG_NEAR ?x ?y)) (nearmoving ?x ?y))) (forall (?x ?y - object) (when (and (nearmoving ?x ?y) (not (DATALOG_MOVINGOBJECT ?y))) (not (nearmoving ?x ?y)))) (forall (?x ?y - object) (when (and (DATALOG_OBJECTX ?y) (veryclose ?x ?y)) (verycloseobject ?x ?y))) (forall (?x ?y - object) (when (and (verycloseobject ?x ?y) (not (DATALOG_OBJECTX ?y))) (not (verycloseobject ?x ?y)))) (nonhornauxupdate)))
(:action Move
  :parameters (?x ?y - object)
  :precondition (and (DATALOG_QUERY0 ?x ?y) (nonhornauxupdate) (not (DATALOG_OBJECTX ?y)) (not (DATALOG_INCONSISTENT)))
  :effect (and (when (not (wetdrone ?x)) (and (not (drone ?x)) (drone ?y))) (when (wetdrone ?x) (and (not (wetdrone ?x)) (not (drone ?x)) (wetdrone ?y))) (not (nonhornauxupdate))))
)
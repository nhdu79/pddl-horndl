(define (domain phone_assembly)
(:requirements :universal-preconditions :conditional-effects)
(:constants
  phone_1 phone_2 phone_3 phone_4 phone_5 phone_6 screen_1 spare_screen_1 battery_1 processor_1 screen_2 battery_2 spare_battery_2 processor_2 screen_3 battery_3 processor_3 spare_processor_3 screen_4 battery_4 processor_4 screen_5 battery_5 processor_5 screen_6 battery_6 processor_6 - object)
(:predicates
  (screeninstalledin ?s ?p - object)
  (batteryinstalledin ?b ?p - object)
  (processorinstalledin ?r ?p - object)
  (phone ?x - object)
  (screen ?x - object)
  (battery ?x - object)
  (processor ?x - object)
  (component ?x - object)
  (inspected ?x - object)
  (tested ?x - object)
  (hasscreen ?p - object)
  (hasbattery ?p - object)
  (hasprocessor ?p - object)
  (fullyequipped ?p - object)
  (readytouse ?x - object)
  (hasbrokenscreen ?p ?s - object)
  (hasbrokenbattery ?p ?b - object)
  (hasbrokenprocessor ?p ?r - object)
  (hasdefect ?p - object)
  (brokenphone ?p - object)
  (warrantyclaim ?p - object)
  (underwarranty ?p - object)
  (repairauthorized ?p - object)
  (DATALOG_COMPONENT ?x0 - object)
  (DATALOG_INCONSISTENT )
  (DATALOG_READYTOUSE ?x0 - object)
  (DATALOG_HASDEFECT ?x0 - object)
  (DATALOG_WARRANTYCLAIM ?x0 - object)
  (DATALOG_HASBATTERY ?x0 - object)
  (DATALOG_HASSCREEN ?x0 - object)
  (DATALOG_HASPROCESSOR ?x0 - object)
  (DATALOG_BROKENPHONE ?x0 - object)
  (DATALOG_FULLYEQUIPPED ?x0 - object))
(:derived (DATALOG_COMPONENT ?x0 - object)
          (component ?x0))
(:derived (DATALOG_COMPONENT ?x0 - object)
          (battery ?x0))
(:derived (DATALOG_INCONSISTENT )
          (exists (?y0 ?y1 ?y2 - object) (and (screeninstalledin ?y0 ?y1) (screeninstalledin ?y0 ?y2) (not (= ?y1 ?y2)))))
(:derived (DATALOG_READYTOUSE ?x0 - object)
          (readytouse ?x0))
(:derived (DATALOG_READYTOUSE ?x0 - object)
          (and (inspected ?x0) (tested ?x0)))
(:derived (DATALOG_HASDEFECT ?x0 - object)
          (hasdefect ?x0))
(:derived (DATALOG_HASDEFECT ?x0 - object)
          (exists (?y0 - object) (hasbrokenprocessor ?x0 ?y0)))
(:derived (DATALOG_INCONSISTENT )
          (exists (?y0 ?y1 ?y2 - object) (and (hasbrokenprocessor ?y0 ?y1) (hasbrokenprocessor ?y0 ?y2) (not (= ?y1 ?y2)))))
(:derived (DATALOG_INCONSISTENT )
          (exists (?y0 ?y1 ?y2 - object) (and (batteryinstalledin ?y0 ?y1) (batteryinstalledin ?y0 ?y2) (not (= ?y1 ?y2)))))
(:derived (DATALOG_INCONSISTENT )
          (exists (?y0 ?y1 ?y2 - object) (and (screeninstalledin ?y0 ?y2) (screeninstalledin ?y1 ?y2) (not (= ?y0 ?y1)))))
(:derived (DATALOG_INCONSISTENT )
          (exists (?y0 ?y1 ?y2 - object) (and (hasbrokenbattery ?y0 ?y1) (hasbrokenbattery ?y0 ?y2) (not (= ?y1 ?y2)))))
(:derived (DATALOG_WARRANTYCLAIM ?x0 - object)
          (warrantyclaim ?x0))
(:derived (DATALOG_WARRANTYCLAIM ?x0 - object)
          (and (DATALOG_HASDEFECT ?x0) (underwarranty ?x0)))
(:derived (DATALOG_INCONSISTENT )
          (exists (?y0 ?y1 ?y2 - object) (and (hasbrokenscreen ?y0 ?y1) (hasbrokenscreen ?y0 ?y2) (not (= ?y1 ?y2)))))
(:derived (DATALOG_HASDEFECT ?x0 - object)
          (exists (?y0 - object) (hasbrokenscreen ?x0 ?y0)))
(:derived (DATALOG_HASBATTERY ?x0 - object)
          (hasbattery ?x0))
(:derived (DATALOG_HASBATTERY ?x0 - object)
          (exists (?y0 - object) (batteryinstalledin ?y0 ?x0)))
(:derived (DATALOG_HASSCREEN ?x0 - object)
          (hasscreen ?x0))
(:derived (DATALOG_HASSCREEN ?x0 - object)
          (exists (?y0 - object) (screeninstalledin ?y0 ?x0)))
(:derived (DATALOG_HASPROCESSOR ?x0 - object)
          (hasprocessor ?x0))
(:derived (DATALOG_HASPROCESSOR ?x0 - object)
          (exists (?y0 - object) (processorinstalledin ?y0 ?x0)))
(:derived (DATALOG_BROKENPHONE ?x0 - object)
          (brokenphone ?x0))
(:derived (DATALOG_BROKENPHONE ?x0 - object)
          (and (DATALOG_FULLYEQUIPPED ?x0) (DATALOG_HASDEFECT ?x0)))
(:derived (DATALOG_INCONSISTENT )
          (exists (?y0 ?y1 ?y2 - object) (and (processorinstalledin ?y0 ?y1) (processorinstalledin ?y0 ?y2) (not (= ?y1 ?y2)))))
(:derived (DATALOG_INCONSISTENT )
          (exists (?y0 ?y1 ?y2 - object) (and (batteryinstalledin ?y0 ?y2) (batteryinstalledin ?y1 ?y2) (not (= ?y0 ?y1)))))
(:derived (DATALOG_INCONSISTENT )
          (exists (?y0 ?y1 ?y2 - object) (and (hasbrokenscreen ?y0 ?y2) (hasbrokenscreen ?y1 ?y2) (not (= ?y0 ?y1)))))
(:derived (DATALOG_INCONSISTENT )
          (exists (?y0 ?y1 ?y2 - object) (and (hasbrokenbattery ?y0 ?y2) (hasbrokenbattery ?y1 ?y2) (not (= ?y0 ?y1)))))
(:derived (DATALOG_INCONSISTENT )
          (exists (?y0 ?y1 ?y2 - object) (and (processorinstalledin ?y0 ?y2) (processorinstalledin ?y1 ?y2) (not (= ?y0 ?y1)))))
(:derived (DATALOG_COMPONENT ?x0 - object)
          (screen ?x0))
(:derived (DATALOG_COMPONENT ?x0 - object)
          (processor ?x0))
(:derived (DATALOG_FULLYEQUIPPED ?x0 - object)
          (fullyequipped ?x0))
(:derived (DATALOG_FULLYEQUIPPED ?x0 - object)
          (and (DATALOG_HASBATTERY ?x0) (DATALOG_HASPROCESSOR ?x0) (DATALOG_HASSCREEN ?x0)))
(:derived (DATALOG_INCONSISTENT )
          (exists (?y0 ?y1 ?y2 - object) (and (hasbrokenprocessor ?y0 ?y2) (hasbrokenprocessor ?y1 ?y2) (not (= ?y0 ?y1)))))
(:derived (DATALOG_HASDEFECT ?x0 - object)
          (exists (?y0 - object) (hasbrokenbattery ?x0 ?y0)))
(:action inspect
  :parameters (?c - object)
  :precondition (and (DATALOG_COMPONENT ?c) (not (DATALOG_INCONSISTENT)))
  :effect (inspected ?c))
(:action test
  :parameters (?c - object)
  :precondition (and (DATALOG_COMPONENT ?c) (inspected ?c) (not (DATALOG_INCONSISTENT)))
  :effect (tested ?c))
(:action install-screen
  :parameters (?s ?p - object)
  :precondition (and (DATALOG_COMPONENT ?s) (DATALOG_READYTOUSE ?s) (phone ?p) (screen ?s) (forall (?b - object) (not (hasbrokenscreen ?p ?b))) (not (DATALOG_HASSCREEN ?p)) (not (DATALOG_INCONSISTENT)))
  :effect (screeninstalledin ?s ?p))
(:action install-battery
  :parameters (?b ?p - object)
  :precondition (and (DATALOG_COMPONENT ?b) (DATALOG_READYTOUSE ?b) (battery ?b) (phone ?p) (forall (?b2 - object) (not (hasbrokenbattery ?p ?b2))) (not (DATALOG_HASBATTERY ?p)) (not (DATALOG_INCONSISTENT)))
  :effect (batteryinstalledin ?b ?p))
(:action install-processor
  :parameters (?r ?p - object)
  :precondition (and (DATALOG_COMPONENT ?r) (DATALOG_READYTOUSE ?r) (phone ?p) (processor ?r) (forall (?b - object) (not (hasbrokenprocessor ?p ?b))) (not (DATALOG_HASPROCESSOR ?p)) (not (DATALOG_INCONSISTENT)))
  :effect (processorinstalledin ?r ?p))
(:action authorize-repair
  :parameters (?p - object)
  :precondition (and (DATALOG_BROKENPHONE ?p) (phone ?p) (underwarranty ?p) (not (DATALOG_INCONSISTENT)))
  :effect (repairauthorized ?p))
(:action repair
  :parameters (?p - object)
  :precondition (and (DATALOG_BROKENPHONE ?p) (phone ?p) (repairauthorized ?p) (not (DATALOG_INCONSISTENT)))
  :effect (and (not (brokenphone ?p)) (forall (?s - object) (when (hasbrokenscreen ?p ?s) (and (not (screeninstalledin ?s ?p)) (not (fullyequipped ?p))))) (forall (?b - object) (when (hasbrokenbattery ?p ?b) (and (not (batteryinstalledin ?b ?p)) (not (fullyequipped ?p))))) (forall (?r - object) (when (hasbrokenprocessor ?p ?r) (and (not (processorinstalledin ?r ?p)) (not (fullyequipped ?p)))))))
)
(define (problem BTcat_problem)
(:domain BTcat)
(:init
       (dynamitebomb ab)
       (blackcat ad)
       (orangecat ah)
       (blackcat am)
       (blackcat ao)
       (blackcat ar)
       (dynamitebomb as)
       (blackcat au)
       (dynamitebomb av)
       (blackcat az)
       (contains ak as)
       (contains aq av)
       (contains ax ab)
       (contains an ar)
       (contains aw au)
       (contains al am)
       (contains af az)
       (contains ap ao)
       (contains ay ad)
       (contains ac ah))
(:goal (and (forall (?x - object) (or (disarmed ?x) (not (DATALOG_PACKAGE ?x)))) (not (DATALOG_INCONSISTENT))))
)
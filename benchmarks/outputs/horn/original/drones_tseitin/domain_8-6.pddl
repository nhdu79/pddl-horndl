(define (domain drone)
(:constants
  aa ab ac ad ae af ag ah ba bb bc bd be bf bg bh ca cb cc cd ce cf cg ch da db dc dd de df dg dh ea eb ec ed ee ef eg eh fa fb fc fd fe ff fg fh ga gb gc gd ge gf gg gh ha hb hc hd he hf hg hh env - object)
(:predicates
  (environment ?x ?y - object)
  (rainyenvironment ?x ?y - object)
  (lowvisibilityenvironment ?x ?y - object)
  (rain ?x - object)
  (drone ?x - object)
  (wetdrone ?x - object)
  (lowvisibility ?x - object)
  (near ?x ?y - object)
  (nearmovingobject ?x ?y - object)
  (nearobjectx ?x ?y - object)
  (veryclose ?x ?y - object)
  (verycloseobjectx ?x ?y - object)
  (human ?x - object)
  (movingobject ?x - object)
  (objectx ?x - object)
  (riskofphysicaldamage ?x - object)
  (tree ?x - object)
  (nonhornauxrainyenvironment ?x ?y - object)
  (nonhornauxlowvisibilityenvironment ?x ?y - object)
  (nonhornauxnearmovingobject ?x ?y - object)
  (nonhornauxverycloseobjectx ?x ?y - object)
  (nonhornauxnearobjectx ?x ?y - object)
  (DATALOG_VERYCLOSE ?x0 ?x1 - object)
  (DATALOG_NEAR ?x0 ?x1 - object)
  (DATALOG_INCONSISTENT)
  (DATALOG_MOVINGOBJECT ?x0 - object)
  (DATALOG_NEAROBJECTXSOMETHING ?x0 - object)
  (DATALOG_NEARMOVINGOBJECT ?x0 ?x1 - object)
  (DATALOG_NEAROBJECTX ?x0 ?x1 - object)
  (DATALOG_RISKOFPHYSICALDAMAGE ?x0 - object)
  (DATALOG_NEARMOVINGOBJECTSOMETHING ?x0 - object)
  (DATALOG_OBJECTX ?x0 - object)
  (DATALOG_VERYCLOSEOBJECTXSOMETHING ?x0 - object)
  (DATALOG_LOWVISIBILITYENVIRONMENTSOMETHING ?x0 - object)
  (DATALOG_QUERY1)
  (DATALOG_VERYCLOSEOBJECTX ?x0 ?x1 - object)
  (DATALOG_DRONE ?x0 - object)
  (DATALOG_QUERY0 ?x0 ?x1 - object)
  (AUX0 ?y1 - object ?y0 - object)
  (AUX1 ?y1 - object ?y0 - object)
  (AUX2 ?y1 - object ?y0 - object)
  (AUX3 ?y1 - object ?y0 - object)
  (AUX4 ?y1 - object ?y0 - object)
  (AUX5 ?y0 - object)
  (AUX6 ?y0 - object)
  (AUX7 ?y1 - object ?y0 - object))
(:derived (nonhornauxrainyenvironment ?y0 ?y1 - object)
          (exists (?y0 ?y1 - object) (AUX0 ?y1 ?y0)))
(:derived (nonhornauxlowvisibilityenvironment ?y0 ?y1 - object)
          (exists (?y0 ?y1 - object) (AUX1 ?y1 ?y0)))
(:derived (nonhornauxnearmovingobject ?y0 ?y1 - object)
          (exists (?y0 ?y1 - object) (AUX2 ?y1 ?y0)))
(:derived (nonhornauxnearobjectx ?y0 ?y1 - object)
          (exists (?y0 ?y1 - object) (AUX3 ?y1 ?y0)))
(:derived (nonhornauxverycloseobjectx ?y0 ?y1 - object)
          (exists (?y0 ?y1 - object) (AUX4 ?y1 ?y0)))
(:derived (DATALOG_VERYCLOSE ?x0 ?x1 - object)
          (veryclose ?x0 ?x1))
(:derived (DATALOG_VERYCLOSE ?x0 ?x1 - object)
          (DATALOG_VERYCLOSE ?x1 ?x0))
(:derived (DATALOG_NEAR ?x0 ?x1 - object)
          (near ?x0 ?x1))
(:derived (DATALOG_NEAR ?x0 ?x1 - object)
          (DATALOG_VERYCLOSE ?x0 ?x1))
(:derived (DATALOG_INCONSISTENT)
          (exists (?y0 - object) (AUX5 ?y0)))
(:derived (DATALOG_MOVINGOBJECT ?x0 - object)
          (movingobject ?x0))
(:derived (DATALOG_MOVINGOBJECT ?x0 - object)
          (human ?x0))
(:derived (DATALOG_NEAROBJECTXSOMETHING ?x0 - object)
          (exists (?y0 - object) (DATALOG_NEAROBJECTX ?x0 ?y0)))
(:derived (DATALOG_NEAR ?x0 ?x1 - object)
          (DATALOG_NEAROBJECTX ?x0 ?x1))
(:derived (DATALOG_NEAR ?x0 ?x1 - object)
          (DATALOG_NEAR ?x1 ?x0))
(:derived (DATALOG_MOVINGOBJECT ?x0 - object)
          (DATALOG_DRONE ?x0))
(:derived (DATALOG_VERYCLOSE ?x0 ?x1 - object)
          (DATALOG_VERYCLOSEOBJECTX ?x0 ?x1))
(:derived (DATALOG_NEARMOVINGOBJECT ?x0 ?x1 - object)
          (nearmovingobject ?x0 ?x1))
(:derived (DATALOG_NEARMOVINGOBJECT ?x0 ?x1 - object)
          (DATALOG_NEARMOVINGOBJECT ?x1 ?x0))
(:derived (DATALOG_NEAROBJECTX ?x0 ?x1 - object)
          (nearobjectx ?x0 ?x1))
(:derived (DATALOG_NEAROBJECTX ?x0 ?x1 - object)
          (DATALOG_NEAROBJECTX ?x1 ?x0))
(:derived (DATALOG_RISKOFPHYSICALDAMAGE ?x0 - object)
          (riskofphysicaldamage ?x0))
(:derived (DATALOG_RISKOFPHYSICALDAMAGE ?x0 - object)
          (and (DATALOG_DRONE ?x0) (DATALOG_LOWVISIBILITYENVIRONMENTSOMETHING ?x0) (DATALOG_NEAROBJECTXSOMETHING ?x0)))
(:derived (DATALOG_NEARMOVINGOBJECTSOMETHING ?x0 - object)
          (exists (?y0 - object) (DATALOG_NEARMOVINGOBJECT ?x0 ?y0)))
(:derived (DATALOG_OBJECTX ?x0 - object)
          (objectx ?x0))
(:derived (DATALOG_OBJECTX ?x0 - object)
          (DATALOG_MOVINGOBJECT ?x0))
(:derived (DATALOG_OBJECTX ?x0 - object)
          (tree ?x0))
(:derived (DATALOG_RISKOFPHYSICALDAMAGE ?x0 - object)
          (and (DATALOG_DRONE ?x0) (DATALOG_VERYCLOSEOBJECTXSOMETHING ?x0)))
(:derived (DATALOG_NEAR ?x0 ?x1 - object)
          (DATALOG_NEARMOVINGOBJECT ?x0 ?x1))
(:derived (DATALOG_VERYCLOSEOBJECTXSOMETHING ?x0 - object)
          (exists (?y0 - object) (DATALOG_VERYCLOSEOBJECTX ?x0 ?y0)))
(:derived (DATALOG_INCONSISTENT)
          (exists (?y0 - object) (AUX6 ?y0)))
(:derived (DATALOG_LOWVISIBILITYENVIRONMENTSOMETHING ?x0 - object)
          (exists (?y0 - object) (lowvisibilityenvironment ?x0 ?y0)))
(:derived (DATALOG_RISKOFPHYSICALDAMAGE ?x0 - object)
          (and (DATALOG_DRONE ?x0) (DATALOG_NEARMOVINGOBJECTSOMETHING ?x0)))
(:derived (DATALOG_QUERY1)
          (exists (?y0 ?y1 - object) (AUX7 ?y1 ?y0)))
(:derived (DATALOG_VERYCLOSEOBJECTX ?x0 ?x1 - object)
          (verycloseobjectx ?x0 ?x1))
(:derived (DATALOG_VERYCLOSEOBJECTX ?x0 ?x1 - object)
          (DATALOG_VERYCLOSEOBJECTX ?x1 ?x0))
(:derived (DATALOG_DRONE ?x0 - object)
          (drone ?x0))
(:derived (DATALOG_DRONE ?x0 - object)
          (wetdrone ?x0))
(:derived (DATALOG_QUERY0 ?x0 ?x1 - object)
          (and (DATALOG_DRONE ?x0) (DATALOG_VERYCLOSE ?x0 ?x1)))
(:derived (AUX0 ?y1 - object ?y0 - object)
          (and (environment ?y0 ?y1) (rain ?y1)))
(:derived (AUX1 ?y1 - object ?y0 - object)
          (and (environment ?y0 ?y1) (lowvisibility ?y1)))
(:derived (AUX2 ?y1 - object ?y0 - object)
          (and (movingobject ?y1) (near ?y0 ?y1)))
(:derived (AUX3 ?y1 - object ?y0 - object)
          (and (near ?y0 ?y1) (objectx ?y1)))
(:derived (AUX4 ?y1 - object ?y0 - object)
          (and (objectx ?y1) (veryclose ?y0 ?y1)))
(:derived (AUX5 ?y0 - object)
          (and (DATALOG_OBJECTX ?y0) (rain ?y0)))
(:derived (AUX6 ?y0 - object)
          (and (DATALOG_DRONE ?y0) (human ?y0)))
(:derived (AUX7 ?y1 - object ?y0 - object)
          (and (DATALOG_NEAR ?y0 ?y1) (DATALOG_RISKOFPHYSICALDAMAGE ?y0) (DATALOG_RISKOFPHYSICALDAMAGE ?y1)))
(:action Move
  :parameters (?x ?y - object)
  :precondition (and (DATALOG_QUERY0 ?x ?y) (not (DATALOG_OBJECTX ?y)) (not (DATALOG_INCONSISTENT)))
  :effect (and (when (not (wetdrone ?x)) (and (not (drone ?x)) (drone ?y))) (when (wetdrone ?x) (and (not (wetdrone ?x)) (not (drone ?x)) (wetdrone ?y)))))
(:action nonHornAuxAddRainyEnvironment
  :parameters (?x ?y - object)
  :precondition (and (nonhornauxrainyenvironment ?x ?y) (not (DATALOG_INCONSISTENT)))
  :effect (rainyenvironment ?x ?y))
(:action nonHornAuxAddLowVisibilityEnvironment
  :parameters (?x ?y - object)
  :precondition (and (nonhornauxlowvisibilityenvironment ?x ?y) (not (DATALOG_INCONSISTENT)))
  :effect (lowvisibilityenvironment ?x ?y))
(:action nonHornAuxAddNearMovingObject
  :parameters (?x ?y - object)
  :precondition (and (nonhornauxnearmovingobject ?x ?y) (not (DATALOG_INCONSISTENT)))
  :effect (nearmovingobject ?x ?y))
(:action nonHornAuxAddNearObjectX
  :parameters (?x ?y - object)
  :precondition (and (nonhornauxnearmovingobject ?x ?y) (not (DATALOG_INCONSISTENT)))
  :effect (nearobjectx ?x ?y))
(:action nonHornAuxAddVeryCloseObjectX
  :parameters (?x ?y - object)
  :precondition (and (nonhornauxverycloseobjectx ?x ?y) (not (DATALOG_INCONSISTENT)))
  :effect (verycloseobjectx ?x ?y))
)
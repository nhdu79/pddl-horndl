(define (domain queens)
(:constants
  aa ab ac ad ae af ba bb bc bd be bf ca cb cc cd ce cf da db dc dd de df ea eb ec ed ee ef fa fb fc fd fe ff - object)
(:predicates
  (queen ?x - object)
  (figure ?x - object)
  (rightdiagonal ?x ?y - object)
  (backdiagonal ?x ?y - object)
  (inline ?x ?y - object)
  (horinline ?x ?y - object)
  (verinline ?x ?y - object)
  (DATALOG_VERINLINE ?x0 ?x1 - object)
  (DATALOG_QUERY0 ?x0 ?x1 - object)
  (DATALOG_RIGHTDIAGONAL ?x0 ?x1 - object)
  (DATALOG_HORINLINE ?x0 ?x1 - object)
  (DATALOG_BACKDIAGONAL ?x0 ?x1 - object)
  (DATALOG_INLINE ?x0 ?x1 - object)
  (DATALOG_FIGURE ?x0 - object))
(:derived (DATALOG_VERINLINE ?x0 ?x1 - object)
          (verinline ?x0 ?x1))
(:derived (DATALOG_VERINLINE ?x0 ?x1 - object)
          (DATALOG_VERINLINE ?x1 ?x0))
(:derived (DATALOG_QUERY0 ?x0 ?x1 - object)
          (and (DATALOG_INLINE ?x0 ?x1) (queen ?x0)))
(:derived (DATALOG_RIGHTDIAGONAL ?x0 ?x1 - object)
          (rightdiagonal ?x0 ?x1))
(:derived (DATALOG_RIGHTDIAGONAL ?x0 ?x1 - object)
          (exists (?y0 - object) (and (DATALOG_RIGHTDIAGONAL ?x0 ?y0) (DATALOG_RIGHTDIAGONAL ?y0 ?x1))))
(:derived (DATALOG_RIGHTDIAGONAL ?x0 ?x1 - object)
          (DATALOG_RIGHTDIAGONAL ?x1 ?x0))
(:derived (DATALOG_HORINLINE ?x0 ?x1 - object)
          (horinline ?x0 ?x1))
(:derived (DATALOG_HORINLINE ?x0 ?x1 - object)
          (DATALOG_HORINLINE ?x1 ?x0))
(:derived (DATALOG_BACKDIAGONAL ?x0 ?x1 - object)
          (backdiagonal ?x0 ?x1))
(:derived (DATALOG_BACKDIAGONAL ?x0 ?x1 - object)
          (exists (?y0 - object) (and (DATALOG_BACKDIAGONAL ?x0 ?y0) (DATALOG_BACKDIAGONAL ?y0 ?x1))))
(:derived (DATALOG_INLINE ?x0 ?x1 - object)
          (inline ?x0 ?x1))
(:derived (DATALOG_INLINE ?x0 ?x1 - object)
          (DATALOG_HORINLINE ?x0 ?x1))
(:derived (DATALOG_INLINE ?x0 ?x1 - object)
          (DATALOG_RIGHTDIAGONAL ?x0 ?x1))
(:derived (DATALOG_BACKDIAGONAL ?x0 ?x1 - object)
          (DATALOG_BACKDIAGONAL ?x1 ?x0))
(:derived (DATALOG_INLINE ?x0 ?x1 - object)
          (DATALOG_VERINLINE ?x0 ?x1))
(:derived (DATALOG_VERINLINE ?x0 ?x1 - object)
          (exists (?y0 - object) (and (DATALOG_VERINLINE ?x0 ?y0) (DATALOG_VERINLINE ?y0 ?x1))))
(:derived (DATALOG_HORINLINE ?x0 ?x1 - object)
          (exists (?y0 - object) (and (DATALOG_HORINLINE ?x0 ?y0) (DATALOG_HORINLINE ?y0 ?x1))))
(:derived (DATALOG_INLINE ?x0 ?x1 - object)
          (DATALOG_INLINE ?x1 ?x0))
(:derived (DATALOG_FIGURE ?x0 - object)
          (figure ?x0))
(:derived (DATALOG_FIGURE ?x0 - object)
          (queen ?x0))
(:derived (DATALOG_INLINE ?x0 ?x1 - object)
          (DATALOG_BACKDIAGONAL ?x0 ?x1))
(:action Move
  :parameters (?x ?y - object)
  :precondition (and (DATALOG_QUERY0 ?x ?y) (not (DATALOG_FIGURE ?y)))
  :effect (and (not (queen ?x)) (queen ?y)))
)
(define (problem BTcat_problem)
(:domain BTcat)
(:objects
  aa ab ac ad ae af ag ah ai aj ak al am an ao ap aq ar as at au av aw ax ay az ba bb - object)
(:init
       (orangecat aa)
       (orangecat ad)
       (orangecat af)
       (smokebomb ah)
       (jagerbomb ak)
       (blackcat am)
       (jagerbomb an)
       (jagerbomb ao)
       (blackcat aq)
       (orangecat as)
       (orangecat at)
       (orangecat ba)
       (contains az an)
       (contains ar ah)
       (contains ax ak)
       (contains ap ao)
       (contains aw aa)
       (contains aj aq)
       (contains al am)
       (contains ai at)
       (contains ac ba)
       (contains ay as)
       (contains bb ad)
       (contains ab af))
(:goal (and (forall (?x - object) (or (disarmed ?x) (not (DATALOG_PACKAGE ?x)))) (not (DATALOG_INCONSISTENT))))
)
(define (problem BTcat_problem)
(:domain BTcat)
(:objects
  aa ab ac ad ae af ag ah ai aj ak al am an ao ap aq ar as at au av aw ax ay az ba bb bc bd - object)
(:init
       (blackcat ac)
       (blackcat ae)
       (blackcat ah)
       (blackcat ai)
       (blackcat aj)
       (smokebomb am)
       (blackcat ap)
       (blackcat ar)
       (jagerbomb at)
       (blackcat au)
       (jagerbomb az)
       (blackcat bc)
       (jagerbomb bd)
       (contains aw at)
       (contains ak bd)
       (contains ba am)
       (contains ad az)
       (contains ao ac)
       (contains ax ap)
       (contains aa bc)
       (contains as ae)
       (contains av ah)
       (contains bb aj)
       (contains ag au)
       (contains ay ai)
       (contains al ar))
(:goal (and (forall (?x - object) (or (disarmed ?x) (not (DATALOG_PACKAGE ?x)))) (not (DATALOG_INCONSISTENT))))
)
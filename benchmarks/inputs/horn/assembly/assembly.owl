@prefix : <http://www.semanticweb.org/anon/ontologies/2025/5/Assembly/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/anon/ontologies/2025/5/Assembly/> .

<http://www.semanticweb.org/anon/ontologies/2025/5/Assembly> rdf:type owl:Ontology .


#################################################################
#    Object Properties
#
#    All three roles are functional.  Each appears only on the LHS
#    (as an inverse existential in a range axiom) — never on the
#    RHS of any role or concept inclusion, satisfying the DL-Lite
#    Horn grammar restriction on functional roles.
#################################################################

### ∃screenInstalledIn⁻ ⊑ HasScreen
:screenInstalledIn rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:range :HasScreen .

### ∃batteryInstalledIn⁻ ⊑ HasBattery
:batteryInstalledIn rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:range :HasBattery .

### ∃boardInstalledIn⁻ ⊑ HasBoard
:boardInstalledIn rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:range :HasBoard .


#################################################################
#    Classes — component types
#    Pure planning predicates; no TBox concept inclusions.
#    Set in problem init; the TBox does not reason over them.
#################################################################

:Screen    rdf:type owl:Class .
:Battery   rdf:type owl:Class .
:Processor rdf:type owl:Class .


#################################################################
#    Classes — assembly status
#    Derived via range axioms (HasScreen/HasBattery/HasBoard)
#    and the conjunction chain below.
#################################################################

:HasScreen         rdf:type owl:Class .
:HasBattery        rdf:type owl:Class .
:HasBoard          rdf:type owl:Class .
:HasCoreComponents rdf:type owl:Class .
:FullyEquipped     rdf:type owl:Class .


#################################################################
#    Classes — certification status
#    Inspected and Tested are directly managed by planning actions.
#    ReadyToUse is conjunction-derived.
#################################################################

:Inspected    rdf:type owl:Class .
:Tested       rdf:type owl:Class .
:ReadyToUse   rdf:type owl:Class .
:Validated    rdf:type owl:Class .
:ProductRecord rdf:type owl:Class .


#################################################################
#    General axioms — conjunction on LHS (Horn DL-Lite fragment)
#
#    Left-to-right position in intersectionOf encodes Horn update
#    priority: when the RHS is deleted, the FIRST conjunct that is
#    not shielded by an insertion request (Ap) is the deletion victim.
#################################################################

###  HasScreen ⊓ HasBattery ⊑ HasCoreComponents   [HasScreen first]
###
###  Horn cascade: Am_HasCoreComponents + Ap_HasBattery → Del_HasScreen
[ owl:intersectionOf ( :HasScreen :HasBattery ) ;
  rdf:type owl:Class ;
  rdfs:subClassOf :HasCoreComponents ] .

###  HasCoreComponents ⊓ HasBoard ⊑ FullyEquipped   [HasCoreComponents first]
###
###  Conjunction chain: RHS of the axiom above is a conjunct here.
###  Horn cascade: Am_FullyEquipped + Ap_HasBoard → Del_HasCoreComponents,
###  which then triggers the cascade above.
[ owl:intersectionOf ( :HasCoreComponents :HasBoard ) ;
  rdf:type owl:Class ;
  rdfs:subClassOf :FullyEquipped ] .

###  Inspected ⊓ Tested ⊑ ReadyToUse   [Inspected first]
###
###  Horn cascade exploited by remove-and-rework-screen:
###    Ap_Inspected shields Inspected → Tested is the first non-Ap conjunct
###    → Del_Tested.  Net: component retains Inspected, loses only Tested.
[ owl:intersectionOf ( :Inspected :Tested ) ;
  rdf:type owl:Class ;
  rdfs:subClassOf :ReadyToUse ] .

###  FullyEquipped ⊓ Validated ⊑ ProductRecord   [FullyEquipped first]
###
###  Demonstrates information preservation (Stratum 3, rules 18-19):
###    When FullyEquipped is explicitly deleted (Am_FullyEquipped, e.g. via
###    remove-and-rework-screen) but Validated still holds and nobody requests
###    Del_ProductRecord, then preInsCl fires and ins_ProductRecord explicitly
###    asserts ProductRecord in the ABox — the quality record persists through
###    disassembly.  LTR ordering means: if ProductRecord itself is revoked
###    (Am_ProductRecord), FullyEquipped is the first non-Ap conjunct to be
###    questioned, not Validated.
[ owl:intersectionOf ( :FullyEquipped :Validated ) ;
  rdf:type owl:Class ;
  rdfs:subClassOf :ProductRecord ] .
